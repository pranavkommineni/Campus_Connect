# Copy to .env and change the placeholders. Never commit .env.
DATABASE_URL=postgresql+psycopg://campus:CHANGE_ME@localhost:5432/campusconnect
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
# --- AWS (leave blank for local development adapters) ---
STORAGE_BACKEND=local          # local | s3
S3_BUCKET=
S3_PUBLIC_BASE_URL=            # e.g. CloudFront domain https://dxxxx.cloudfront.net
QUEUE_BACKEND=local            # local | sqs
SQS_QUEUE_URL=
AWS_REGION=ap-south-1
